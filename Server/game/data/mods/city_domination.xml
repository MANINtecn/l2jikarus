                <level id="3" npcId="18991" hp="0" pAtk="0" costAdena="20000000"    costLCoins="5000"  />
                <level id="4" npcId="29195" hp="0" pAtk="0" costAdena="50000000"    costLCoins="10000" />
            </levels>
        </city>
    </cities>

</city-domination>
